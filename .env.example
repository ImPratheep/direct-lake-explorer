# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ==============================================================================
# This project operates LOCALLY ONLY - no Microsoft Fabric account required
# All operations use synthetic datasets, DuckDB, and local file storage
# ==============================================================================

# Application Environment
NODE_ENV=development
API_PORT=3000
API_HOST=localhost

# Local Data Storage
# Path to synthetic datasets and Parquet files
DATA_DIRECTORY=./data
PARQUET_DATA_PATH=./data/parquet
DELTA_LAKE_PATH=./data/delta

# DuckDB Configuration
# Local analytical query engine
DUCKDB_DATABASE_PATH=./data/duckdb.db
DUCKDB_MEMORY_LIMIT=4GB

# Simulation Configuration
# Controls Direct Lake simulation behavior
SIMULATE_DIRECT_LAKE=true
SIMULATE_TRANSCODING=true
SIMULATE_VERTIPAQ=true
SIMULATE_QUERY_PROCESSING=true
SIMULATION_MODE=development

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# ==============================================================================
# FUTURE INTEGRATION (Optional, not required for initial development)
# ==============================================================================
# These settings are placeholders for potential Microsoft Fabric integration
# in future versions. Do NOT fill these in for initial local development.
# Uncomment only when Fabric integration is implemented.
# ==============================================================================

# Microsoft Fabric Integration (Future Use - Leave Blank)
# FABRIC_WORKSPACE_ID=
# FABRIC_CAPACITY_ID=
# FABRIC_DATASET_NAME=
# FABRIC_CLIENT_ID=
# FABRIC_CLIENT_SECRET=
# FABRIC_TENANT_ID=
# FABRIC_ENVIRONMENT=

# Azure Data Lake Integration (Future Use - Leave Blank)
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_CONTAINER_NAME=
# AZURE_TENANT_ID=
